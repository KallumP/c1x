{
  "name": "c1x-level-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build-level": "tsx builder/buildLevelCli.ts",
    "bundle-builder": "esbuild builder/buildLevelCli.ts --bundle --platform=node --format=cjs --log-level=error --outfile=../../build/build-level/build-level.cjs",
    "builder-exe": "npm run bundle-builder && tsx scripts/builderExeCli.ts",
    "export-cut-level": "tsx scripts/cutLevel/exportCutLevelCli.ts",
    "release": "tsx scripts/releaseCli.ts"
  },
  "dependencies": {
    "@react-three/drei": "9.114.0",
    "@react-three/fiber": "8.17.10",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0",
    "utif": "3.1.0"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@types/utif": "3.0.6",
    "@vitejs/plugin-react": "4.3.3",
    "postject": "1.0.0-alpha.6",
    "tsx": "4.21.1",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
